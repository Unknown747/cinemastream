# ============================================================================
# CinemaStream — Environment Variables
# ============================================================================
# Salin file ini menjadi `.env` lalu isi nilai-nilainya.
# Di VPS / production: set lewat systemd / docker -e / panel hosting.
# Di Replit: pakai panel "Secrets" (Tools → Secrets), JANGAN commit .env.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. DATABASE  (WAJIB)
# ----------------------------------------------------------------------------
# PostgreSQL connection string. Gunakan database eksternal (Neon, Supabase,
# Railway, atau PostgreSQL lokal di VPS).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/cinemastream


# ----------------------------------------------------------------------------
# 2. AI TRANSLATION  (OPSIONAL — kalau kosong, judul/sinopsis Mandarin
#    akan tampil apa adanya, tidak diterjemahkan ke Indonesia)
# ----------------------------------------------------------------------------
# Endpoint OpenAI-compatible. Contoh provider:
#   - OpenAI resmi  : https://api.openai.com/v1
#   - DeepSeek      : https://api.deepseek.com/v1   (paling murah utk Mandarin)
#   - Groq          : https://api.groq.com/openai/v1   (gratis tier)
#   - OpenRouter    : https://openrouter.ai/api/v1
#   - Ollama lokal  : http://localhost:11434/v1   (gratis, butuh GPU/RAM besar)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Nama model. Sesuaikan dengan provider:
#   - OpenAI   : gpt-4o-mini   (default lama: gpt-5-mini)
#   - DeepSeek : deepseek-chat
#   - Groq     : llama-3.1-70b-versatile
#   - Ollama   : llama3.1
AI_MODEL=gpt-4o-mini


# ----------------------------------------------------------------------------
# 3. ADMIN PANEL  (WAJIB di production)
# ----------------------------------------------------------------------------
# Password untuk login halaman /admin.
ADMIN_PASSWORD=ganti-dengan-password-yang-kuat

# Secret untuk signing session cookie. WAJIB random ≥32 karakter.
# Generate cepat: openssl rand -base64 48
SESSION_SECRET=ganti-dengan-string-acak-panjang-min-32-karakter
COOKIE_SECRET=ganti-dengan-string-acak-panjang-min-32-karakter


# ----------------------------------------------------------------------------
# 4. SERVER  (OPSIONAL)
# ----------------------------------------------------------------------------
# Port untuk API server. Default: 8080.
PORT=8080

# Mode runtime. "production" mengaktifkan optimasi & HTTPS-only cookies.
NODE_ENV=production

# Level log: trace | debug | info | warn | error. Default: info.
LOG_LEVEL=info

# Domain frontend yang diizinkan request ke API (CORS). Pisahkan dengan koma.
# Contoh: https://cinemastream.id,https://www.cinemastream.id
CORS_ORIGIN=https://cinemastream.id

# URL publik situs Anda. Dipakai untuk sitemap, RSS, JSON-LD, canonical URL.
SITE_URL=https://cinemastream.id


# ----------------------------------------------------------------------------
# 5. FRONTEND BUILD-TIME  (OPSIONAL — prefix VITE_ wajib)
# ----------------------------------------------------------------------------
# Variabel ini di-inline saat `pnpm build`, jadi harus diset SEBELUM build.
# Kalau kosong, slot iklan tidak tampil di production.

# AdSense client ID Anda, format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT=

# Aktifkan Auto Ads (Google otomatis pasang iklan tambahan di tempat optimal).
# Sangat disarankan: true. Lihat ADS.md untuk detail.
VITE_ADSENSE_AUTO_ADS=true

# Slot ID untuk masing-masing posisi iklan
# (Buat di AdSense Dashboard → Ads → By ad unit → Display ads)
VITE_ADSENSE_SLOT_HOME_TOP=
VITE_ADSENSE_SLOT_IN_ARTICLE=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_CHANNEL_BOTTOM=
VITE_ADSENSE_SLOT_BLOG_BOTTOM=

# Sticky bottom anchor — format paling tinggi RPM-nya untuk mobile.
# Buat unit baru tipe "Anchor / Sticky" atau "Display" responsive.
VITE_ADSENSE_SLOT_STICKY_BOTTOM=

# Path dasar (kalau frontend tidak di-host di root domain).
# Default: /
BASE_PATH=/
